# static-server — configurable environment variables
# Copy to .env for local development, or pass directly to docker run / Kubernetes.
# All values have built-in defaults; override only what you need to change.

# ── Runtime ───────────────────────────────────────────────────────────────────

# TCP port the server listens on.
PORT=8080

# Primary directory to serve static files from.
# Mount any volume type here: ConfigMap, emptyDir (populated by initContainer),
# PVC, hostPath, NFS, etc. The server does not care how files arrive — it just
# serves whatever is at this path.
SERVE_DIR=/app/public

# Fallback directory served when a file is not found in SERVE_DIR.
# Set to the baked-in defaults directory by the container image (see Dockerfile).
# Enables partial overlays: mount only the files you want to override in SERVE_DIR
# and let FALLBACK_DIR supply the rest (e.g. mount only index.html; style.css and
# script.js fall through to the baked-in copies).
# Set to an empty string to disable the fallback entirely.
FALLBACK_DIR=/app/default

# ── Single-page app (SPA) hosting ─────────────────────────────────────────────

# Serve index.html (HTTP 200) for unknown *navigation* routes — paths whose final
# segment has no file extension — so client-side routing and deep-link refresh work.
# Asset requests (paths with an extension, e.g. /assets/app.js) still 404 on miss,
# so a broken build is not masked. Default: false (a plain static site is unchanged).
SPA_FALLBACK=false

# Path prefix whose files receive a one-year immutable Cache-Control header
# (public, max-age=31536000, immutable). Point this at your build tool's
# fingerprinted-asset directory (Vite emits /assets/). index.html and navigation
# routes always get no-cache so new deploys are picked up immediately.
# Empty (default) disables immutable caching.
CACHE_IMMUTABLE_PREFIX=

# Content-Security-Policy header value. Empty (default) leaves the header unset.
# Set the CSP your app requires; the other security headers are always present.
CONTENT_SECURITY_POLICY=

# Serve a sibling precompressed asset (foo.js.br / foo.js.gz) when the client
# accepts that encoding and the file exists, preserving the original Content-Type.
# Off by default (an edge/CDN that already compresses makes this redundant).
PRECOMPRESSED=false

# ── index.html template variables ─────────────────────────────────────────────
# These variables are substituted into public/index.html at build time (via envsubst).
# The raw template is preserved at /app/default/index.html.tpl for initContainer use.
# Pass to initContainer env: or override at build time via --build-arg / make variables.

# Page title and primary heading.
SITE_TITLE=static-server

# Short description used in meta description, Open Graph, Twitter Card, and JSON-LD.
DESCRIPTION=Minimal scratch container image serving static files via stdlib Go HTTP.

# Meta keywords (comma-separated).
SITE_KEYWORDS=static-server, container, docker, kubernetes, go, golang, scratch, file server, oci, configmap

# Author / vendor name used in meta author and JSON-LD.
VENDOR=Meddleware

# Author organisation URL used in JSON-LD author.
SITE_AUTHOR_URL=https://meddleware.co.uk

# Canonical URL injected as og:url. Empty by default (harmless; set via initContainer
# for social sharing to work correctly).
OG_URL=

# Source code repository URL used in body links and JSON-LD.
SOURCE_URL=https://github.com/meddleware-org/static-server

# OCI-label image URL (with https:// scheme) used in JSON-LD downloadUrl.
IMAGE_URL=https://quay.io/meddleware-org/static-server

# Pull-ready image reference (no scheme) used in docker run and Kubernetes YAML examples.
IMAGE_REF=quay.io/meddleware-org/static-server

# Version string used in JSON-LD. Injected at build time; matches the binary version.
VERSION=dev

# SPDX license URL used in JSON-LD.
SCHEMA_LICENSE_URL=https://opensource.org/licenses/0BSD
